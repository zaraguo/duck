.container {
  padding: 20rpx;
  background-color: #f0f8ff;
  min-height: 100vh;
}

.card {
  background-color: #ffffff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.full-width {
  width: 100%;
  box-sizing: border-box;
}

.task-info {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.task-icon {
  width: 80rpx;
  height: 80rpx;
  margin-bottom: 20rpx;
}

.task-title {
  font-size: 44rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
  color: #333;
}

.task-desc {
  font-size: 28rpx;
  color: #666;
  line-height: 1.5;
}

.check-in-area {
  display: flex;
  flex-direction: row;
  gap: 10rpx;
}

button.main-check-in-button {
  background-color: #4caf50;
  color: #fff;
  padding: 24rpx 45rpx !important;
  border-radius: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  font-size: 36rpx;
  font-weight: bold;
  box-shadow: 0 6rpx 12rpx rgba(76, 175, 80, 0.3);
  transition: all 0.3s ease;
}

.button-icon {
  width: 48rpx;
  height: 48rpx;
}

button.main-check-in-button:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 8rpx rgba(76, 175, 80, 0.3);
}

button.quick-button {
  background-color: #e6f3ff;
  color: #1890ff;
  border-radius: 30rpx;
  display: flex;
  flex: 1;
  justify-content: center;
  align-items: center;
  font-size: 28rpx;
  box-shadow: 0 2rpx 6rpx rgba(24, 144, 255, 0.2);
  transition: all 0.3s ease;
}

button.quick-button:active {
  transform: scale(0.98);
  box-shadow: 0 1rpx 4rpx rgba(24, 144, 255, 0.2);
}

.card-title {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 24rpx;
  display: block;
  color: #333;
  text-align: center;
}

.members-list {
  margin-top: 20rpx;
}

.member-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #eee;
}

.member-avatar {
  width: 70rpx;
  height: 70rpx;
  color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: bold;
  flex-shrink: 0;
}

.member-info {
  flex: 1;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
}

.member-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-right: 16rpx;
  flex-basis: 100%;
  margin-bottom: 8rpx;
}

.progress-container {
  flex: 1;
  height: 16rpx;
  background-color: #e0e0e0;
  border-radius: 8rpx;
  overflow: hidden;
  margin-right: 16rpx;
}

.progress-bar {
  height: 100%;
  background-color: #4caf50;
  border-radius: 8rpx;
  transition: width 0.3s ease;
}

.member-total-checkins {
  font-size: 26rpx;
  color: #666;
  white-space: nowrap;
}

.checkin-item {
  background-color: #f9f9f9;
  padding: 24rpx;
  margin-bottom: 16rpx;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.05);
}

.checkin-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.checkin-user {
  display: flex;
  align-items: center;
}

.checkin-avatar {
  width: 50rpx;
  height: 50rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: bold;
  color: #fff;
  margin-right: 12rpx;
}

.checkin-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.checkin-time {
  font-size: 24rpx;
  color: #999;
}

.member-avatar-container {
  position: relative;
  margin-right: 24rpx;
}

.crown-icon {
  position: absolute;
  top: -20rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 40rpx;
}

.checkin-body {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-direction: row;
}

.checkin-quantity {
  font-size: 32rpx;
  color: #333;
  font-weight: bold;
}

.checkin-remarks {
  font-size: 26rpx;
  color: #666;
}

.modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 999;
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.3s ease, visibility 0.3s ease;
}

.modal.show {
  opacity: 1;
  visibility: visible;
}

.modal-content {
  background: #fff;
  border-radius: 20rpx;
  width: 85%;
  max-width: 600rpx;
  overflow: hidden;
  transform: scale(0.9);
  transition: transform 0.3s ease;
}

.modal.show .modal-content {
  transform: scale(1);
}

.modal-header {
  padding: 24rpx;
  font-size: 36rpx;
  font-weight: bold;
  border-bottom: 1rpx solid #eee;
  text-align: center;
  background-color: #f0f8ff;
  position: relative;
}

.close-icon {
  position: absolute;
  right: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 36rpx;
  height: 36rpx;
}

.modal-body {
  padding: 24rpx;
}

.input-group {
  margin-bottom: 24rpx;
}

.input-label {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 8rpx;
}

.modal-body input, .modal-body textarea {
  width: 100%;
  border: 1px solid #ddd;
  border-radius: 12rpx;
  box-sizing: border-box;
  font-size: 28rpx;
}

.modal-body input {
  height: 70rpx;
}

.modal-body textarea {
  height: 120rpx;
}

.modal-footer {
  display: flex;
  justify-content: space-between;
  padding: 24rpx;
  border-top: 1rpx solid #eee;
  gap: 15rpx;
}

.modal-footer button {
  flex: 1;
  margin: 0 12rpx;
  border-radius: 12rpx;
  font-size: 32rpx;
  padding: 16rpx 0;
}

.cancel-button {
  background-color: #f5f5f5;
  color: #333;
}

.confirm-button {
  background-color: #4caf50;
  color: #fff;
}

.date-picker {
  margin-top: 20rpx;
  display: flex;
  justify-content: center;
  align-items: center;
}

.picker-view {
  background-color: #e6f3ff;
  padding: 10rpx 20rpx;
  border-radius: 10rpx;
  font-size: 28rpx;
  color: #1890ff;
  border: 1px solid #1890ff;
}

button[disabled] {
  opacity: 0.5;
  cursor: not-allowed;
}
