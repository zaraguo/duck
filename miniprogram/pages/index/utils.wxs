var formatNumber = function (n) {
  n = n.toString()
  return n[1] ? n : '0' + n
}

var formatDate = function (dateString) {
  var date = getDate(dateString)
  var year = date.getFullYear()
  var month = date.getMonth() + 1
  var day = date.getDate()
  var hour = date.getHours()
  var minute = date.getMinutes()

  return [year, month, day].map(formatNumber).join('-') + ' ' + [hour, minute].map(formatNumber).join(':')
}

var getSumRecords = function (sumRecords, userId) {
  for (var i = 0; i < sumRecords.length; i++) {
    if (sumRecords[i]._id === userId) {
      return sumRecords[i].sum
    }
  }
  return 0
}

var getAvatarColor = function(id) {
  var colors = ['#1abc9c', '#2ecc71', '#3498db', '#9b59b6', '#34495e', '#16a085', '#27ae60', '#2980b9', '#8e44ad', '#2c3e50', '#f1c40f', '#e67e22', '#e74c3c', '#ecf0f1', '#95a5a6', '#f39c12', '#d35400', '#c0392b', '#bdc3c7', '#7f8c8d'];
  return colors[id.charCodeAt(0) % colors.length];
};

var getNameInitial = function(name) {
  return name.charAt(0).toUpperCase();
};

var calculateProgressWidth = function(quantity, maxQuantity) {
  var progress = (quantity / maxQuantity) * 100;
  return progress > 100 ? 100 : progress;
};

module.exports = {
  formatDate: formatDate,
  getSumRecords: getSumRecords,
  getAvatarColor: getAvatarColor,
  getNameInitial: getNameInitial,
  calculateProgressWidth: calculateProgressWidth
};

