<!--pages/order-detail/order-detail.wxml-->
<view class="container" wx:if="{{order}}">
  <view class="page-header">
    <text class="page-title">订单详情</text>
  </view>
  
  <view class="order-card card">
    <view class="order-header">
      <text class="order-id">订单号: {{order.id}}</text>
      <view class="order-status status-{{order.status}}">
        {{statusMap[order.status]}}
      </view>
    </view>
    
    <view class="order-info">
      <view class="info-item">
        <text class="info-label">下单时间:</text>
        <text class="info-value">{{order.date}}</text>
      </view>
    </view>
    
    <view class="divider"></view>
    
    <view class="order-items">
      <view class="section-title">订单商品</view>
      <view wx:for="{{order.items}}" wx:key="id" class="order-item">
        <view class="item-info">
          <text class="item-name">{{item.name}}</text>
          <text class="item-price">¥{{item.price}}</text>
        </view>
        <view class="item-quantity">x{{item.quantity}}</view>
        <!-- <view class="item-total">{{(item.price * item.quantity).toFixed(2)}}</view> -->
      </view>
    </view>
    
    <view class="divider"></view>
    
    <view class="order-summary">
      <view class="summary-item">
        <text>小计</text>
        <text>¥{{order.total.toFixed(2)}}</text>
      </view>
      <view class="summary-item">
        <text>运费</text>
        <text>¥20.00</text>
      </view>
      <view class="summary-item total">
        <text>总计</text>
        <text>¥{{order.total.toFixed(2)}}</text>
      </view>
    </view>
    
    <view class="divider"></view>
    
    <view class="order-actions">
      <button 
        wx:if="{{order.status === 'pending'}}" 
        class="action-btn btn-primary" 
        bindtap="payOrder"
      >去付款</button>
      <button 
        wx:if="{{order.status === 'shipped'}}" 
        class="action-btn btn-primary" 
        bindtap="confirmReceipt"
      >确认收货</button>
      <button 
        wx:if="{{order.status === 'pending'}}" 
        class="action-btn btn-danger" 
        bindtap="cancelOrder"
      >取消订单</button>
    </view>
  </view>
</view>

