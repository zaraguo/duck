<!--pages/index/index.wxml-->
<view class="container">
  <!-- 轮播图 -->
  <swiper indicator-dots="{{indicatorDots}}" autoplay="{{autoplay}}" interval="{{interval}}" duration="{{duration}}" class="banner-swiper">
    <block wx:for="{{banners}}" wx:key="*this">
      <swiper-item>
        <image src="{{item}}" class="banner-image" mode="aspectFill"></image>
      </swiper-item>
    </block>
  </swiper>
  
  <!-- 分类选项卡 -->
  <view class="category-tabs">
    <view 
      wx:for="{{categories}}" 
      wx:key="*this" 
      class="category-tab {{currentTab === (index === 0 ? 'all' : item) ? 'active' : ''}}"
      data-tab="{{index === 0 ? 'all' : item}}"
      bindtap="switchTab"
    >
      {{item}}
    </view>
  </view>
  
  <!-- 精选推荐 -->
  <view class="section" wx:if="{{currentTab === 'all'}}">
    <view class="section-header">
      <text class="section-title">精选推荐</text>
    </view>
    <view class="product-grid">
      <view 
        wx:for="{{featuredProducts}}" 
        wx:key="id" 
        class="product-card"
        bindtap="navigateToProduct"
        data-id="{{item.id}}"
      >
        <view class="product-image-container">
          <image src="{{item.images[0]}}" class="product-image" mode="aspectFill"></image>
          <view class="product-badge" wx:if="{{item.featured}}">精选</view>
          <view class="product-stock-overlay" wx:if="{{item.stock <= 0}}">
            <text>已售罄</text>
          </view>
        </view>
        <view class="product-info">
          <text class="product-name">{{item.name}}</text>
          <text class="product-price">¥{{item.price}}</text>
          <view class="product-footer">
            <text class="product-stock">库存: {{item.stock}}</text>
            <button 
              class="add-to-cart-btn" 
              catchtap="addToCart" 
              data-id="{{item.id}}"
              disabled="{{item.stock <= 0}}"
            >
              <text class="iconfont icon-cart"></text>
            </button>
          </view>
        </view>
      </view>
    </view>
  </view>
  
  <!-- 商品列表 -->
  <view class="section">
    <view class="section-header">
      <text class="section-title">{{currentTab === 'all' ? '全部商品' : currentTab}}</text>
    </view>
    <view class="product-grid">
      <block wx:for="{{products}}" wx:key="id">
        <view 
          wx:if="{{currentTab === 'all' || item.category === currentTab}}"
          class="product-card"
          bindtap="navigateToProduct"
          data-id="{{item.id}}"
        >
          <view class="product-image-container">
            <image src="{{item.images[0]}}" class="product-image" mode="aspectFill"></image>
            <view class="product-badge" wx:if="{{item.featured}}">精选</view>
            <view class="product-stock-overlay" wx:if="{{item.stock <= 0}}">
              <text>已售罄</text>
            </view>
          </view>
          <view class="product-info">
            <text class="product-name">{{item.name}}</text>
            <text class="product-price">¥{{item.price}}</text>
            <view class="product-footer">
              <text class="product-stock">库存: {{item.stock}}</text>
              <button 
                class="add-to-cart-btn" 
                catchtap="addToCart" 
                data-id="{{item.id}}"
                disabled="{{item.stock <= 0}}"
              >
                <text class="iconfont icon-cart"></text>
              </button>
            </view>
          </view>
        </view>
      </block>
    </view>
  </view>
</view>

