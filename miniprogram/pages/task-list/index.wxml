<view class="container">
    <view class="header">
        <text class="title">任务列表</text>
    </view>

    <view class="task-list">
        <block wx:for="{{tasks}}" wx:key="_id">
            <view class="card task-item" bindtap="navigateToTaskDetail" data-task-id="{{item._id}}">
                <view class="task-header">
                    <text class="task-name">{{item.name}}</text>
                    <view class="task-target">
                        <text class="target-value">{{item.target}}</text>
                        <text class="target-unit">{{item.unit}}</text>
                    </view>
                </view>
                <text class="task-description">{{item.description}}</text>
                <view class="task-footer">
                    <view class="members-info">
                        <image class="icon" src="/images/group-icon.png" mode="aspectFit"></image>
                        <text class="members-count">{{item.members.length}} 人参与</text>
                    </view>
                    <view class="task-progress">
                        <progress percent="{{item.progress}}" stroke-width="4" color="#4caf50" backgroundColor="#e0e0e0" />
                    </view>
                </view>
            </view>
        </block>
    </view>
</view>
