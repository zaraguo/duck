/* pages/admin/admin.wxss */
.page-header {
    padding: 20rpx 0;
    margin-bottom: 20rpx;
  }
  
  .page-title {
    font-size: 36rpx;
    font-weight: bold;
  }
  
  .admin-tabs {
    display: flex;
    background-color: #fff;
    padding: 20rpx 0;
    margin-bottom: 20rpx;
    border-radius: 10rpx;
    box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
  }
  
  .admin-tab {
    flex: 1;
    text-align: center;
    padding: 15rpx 0;
    font-size: 28rpx;
    position: relative;
  }
  
  .admin-tab.active {
    color: var(--primary-color);
    font-weight: bold;
  }
  
  .admin-tab.active::after {
    content: '';
    position: absolute;
    bottom: -10rpx;
    left: 50%;
    transform: translateX(-50%);
    width: 40rpx;
    height: 4rpx;
    background-color: var(--primary-color);
    border-radius: 2rpx;
  }
  
  .tab-content {
    margin-bottom: 30rpx;
  }
  
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20rpx;
    margin-bottom: 20rpx;
  }
  
  .stat-card {
    padding: 30rpx 20rpx;
    text-align: center;
  }
  
  .stat-value {
    font-size: 36rpx;
    font-weight: bold;
    color: var(--primary-color);
    margin-bottom: 10rpx;
  }
  
  .stat-label {
    font-size: 26rpx;
    color: var(--light-text);
  }
  
  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20rpx;
    border-bottom: 1rpx solid var(--border-color);
    font-weight: bold;
  }
  
  .view-all {
    font-size: 24rpx;
    color: var(--primary-color);
    font-weight: normal;
  }
  
  .status-bar {
    display: flex;
    align-items: center;
    margin-bottom: 20rpx;
  }
  
  .status-label {
    width: 120rpx;
    font-size: 26rpx;
  }
  
  .status-count {
    width: 60rpx;
    text-align: center;
    font-size: 26rpx;
    font-weight: bold;
    margin-right: 20rpx;
  }
  
  .status-progress-bg {
    flex: 1;
    height: 20rpx;
    background-color: var(--secondary-color);
    border-radius: 10rpx;
    overflow: hidden;
  }
  
  .status-progress {
    height: 100%;
    border-radius: 10rpx;
  }
  
  .status-pending {
    background-color: #f39c12;
  }
  
  .status-processing {
    background-color: #3498db;
  }
  
  .status-shipped {
    background-color: #9c27b0;
  }
  
  .status-completed {
    background-color: #2ecc71;
  }
  
  .status-cancelled {
    background-color: #e74c3c;
  }
  
  .recent-order {
    padding: 20rpx;
    border-bottom: 1rpx solid var(--border-color);
  }
  
  .recent-order:last-child {
    border-bottom: none;
  }
  
  .order-basic {
    display: flex;
    justify-content: space-between;
    margin-bottom: 10rpx;
  }
  
  .order-id {
    font-size: 28rpx;
    font-weight: bold;
  }
  
  .order-customer {
    font-size: 28rpx;
  }
  
  .order-info {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  
  .order-date {
    font-size: 24rpx;
    color: var(--light-text);
  }
  
  .order-amount {
    font-size: 28rpx;
    font-weight: bold;
    color: var(--primary-color);
  }
  
  .order-status {
    font-size: 24rpx;
    padding: 4rpx 12rpx;
    border-radius: 20rpx;
  }
  
  .action-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20rpx;
  }
  
  .section-title {
    font-size: 32rpx;
    font-weight: bold;
  }
  
  .product-list {
    margin-bottom: 30rpx;
  }
  
  .product-item {
    display: flex;
    padding: 20rpx;
    margin-bottom: 20rpx;
  }
  
  .product-image {
    width: 160rpx;
    height: 160rpx;
    margin-right: 20rpx;
    border-radius: 8rpx;
    overflow: hidden;
  }
  
  .product-image image {
    width: 100%;
    height: 100%;
  }
  
  .product-details {
    flex: 1;
    display: flex;
    flex-direction: column;
  }
  
  .product-name {
    font-size: 28rpx;
    font-weight: bold;
    margin-bottom: 10rpx;
  }
  
  .product-price {
    font-size: 32rpx;
    color: var(--primary-color);
    font-weight: bold;
    margin-bottom: 10rpx;
  }
  
  .product-meta {
    display: flex;
    margin-bottom: 20rpx;
  }
  
  .product-stock, .product-category {
    font-size: 24rpx;
    color: var(--light-text);
    margin-right: 20rpx;
  }
  
  .product-actions {
    display: flex;
    justify-content: flex-end;
  }
  
  .action-btn {
    margin-left: 20rpx;
    font-size: 24rpx;
    padding: 0 20rpx;
    height: 60rpx;
    line-height: 60rpx;
    min-width: 120rpx;
  }
  
  .order-list {
    margin-bottom: 30rpx;
  }
  
  .order-item {
    padding: 20rpx;
    margin-bottom: 20rpx;
  }
  
  .order-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20rpx;
  }
  
  .order-customer-info {
    display: flex;
    justify-content: space-between;
    margin-bottom: 20rpx;
    font-size: 28rpx;
  }
  
  .order-actions {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  
  .status-actions {
    display: flex;
  }
  
  