<!--pages/product/product.wxml-->
<view class="container" wx:if="{{product}}">
  <!-- 商品图片轮播 -->
  <view class="product-image-container">
    <image src="{{product.images[currentImageIndex]}}" class="product-main-image" mode="aspectFill"></image>
    <view class="product-stock-overlay" wx:if="{{product.stock <= 0}}">
      <text>已售罄</text>
    </view>
  </view>
  
  <!-- 缩略图列表 -->
  <scroll-view scroll-x class="thumbnail-scroll">
    <view class="thumbnail-container">
      <view 
        wx:for="{{product.images}}" 
        wx:key="*this" 
        class="thumbnail {{currentImageIndex === index ? 'active' : ''}}"
        bindtap="changeImage"
        data-index="{{index}}"
      >
        <image src="{{item}}" mode="aspectFill"></image>
      </view>
    </view>
  </scroll-view>
  
  <!-- 商品信息 -->
  <view class="product-info card">
    <view class="product-header">
      <text class="product-name">{{product.name}}</text>
      <view class="product-badge" wx:if="{{product.featured}}">精选</view>
    </view>
    <text class="product-price">¥{{product.price}}</text>
    <text class="product-description">{{product.description}}</text>
    
    <view class="product-meta">
      <text class="meta-item">库存: {{product.stock}} 件</text>
      <text class="meta-item">类别: {{product.category}}</text>
    </view>
    
    <view class="divider"></view>
    
    <!-- 数量选择器 -->
    <view class="quantity-selector" wx:if="{{product.stock > 0}}">
      <text class="quantity-label">数量:</text>
      <view class="quantity-controls">
        <view class="quantity-btn" bindtap="decreaseQuantity">-</view>
        <view class="quantity-value">{{quantity}}</view>
        <view class="quantity-btn" bindtap="increaseQuantity">+</view>
      </view>
    </view>
    
    <!-- 操作按钮 -->
    <view class="action-buttons">
      <block wx:if="{{product.stock > 0}}">
        <button class="btn-outline" bindtap="addToCart">加入购物车</button>
        <button class="btn-primary" bindtap="buyNow">立即购买</button>
      </block>
      <button class="btn-disabled" wx:else disabled>已售罄</button>
    </view>
  </view>
</view>

